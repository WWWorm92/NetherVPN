[Unit]
Description=NetherVPN desktop client
After=network-online.target
Wants=network-online.target
# Avoid endless systemd restarts on an invalid profile, occupied TUN,
# missing dependencies or unexpected routing failures.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/nether-client -config /etc/nethervpn/client.conf -settings /etc/nethervpn/client-settings.conf
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
